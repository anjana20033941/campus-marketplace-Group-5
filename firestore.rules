rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function isUniversityVerified() {
      return signedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.universityVerified == true ||
        request.auth.token.email_verified == true
      );
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid && isUniversityVerified();
      allow update, delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if owns(userId);
    }

    match /users/{userId}/saved/{listingId} {
      allow read, write: if owns(userId);
    }

    match /conversations/{conversationId} {
      allow read, write: if signedIn() && request.auth.uid in resource.data.memberIds && isUniversityVerified();
      match /messages/{messageId} {
        allow read, create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
      }
    }

    match /rentRequests/{requestId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.sellerId ||
        request.auth.uid == resource.data.requesterId ||
        (resource.data.sellerEmail != "" && request.auth.token.email == resource.data.sellerEmail) ||
        (resource.data.requesterEmail != "" && request.auth.token.email == resource.data.requesterEmail)
      );
      allow create: if signedIn();
      allow update: if signedIn() && (request.auth.uid == resource.data.sellerId || request.auth.uid == resource.data.requesterId);
    }
  }
}
